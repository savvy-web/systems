{
	"name": "@savvy-web/github-action-builder",
	"version": "2.1.0",
	"private": true,
	"description": "A zero-config build tool for creating GitHub Actions from TypeScript. Bundles with rsbuild, validates action.yml against GitHub's schema, and outputs production-ready Node.js 24 actions.",
	"keywords": [
		"github-actions",
		"github",
		"actions",
		"rsbuild",
		"rspack",
		"bundler",
		"typescript",
		"node24",
		"cli",
		"build-tool",
		"action-builder",
		"effect-ts",
		"esm"
	],
	"homepage": "https://github.com/savvy-web/systems/tree/main/packages/github-action-builder",
	"bugs": {
		"url": "https://github.com/savvy-web/systems/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/savvy-web/systems.git",
		"directory": "packages/github-action-builder"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@savvyweb.systems",
		"url": "https://savvyweb.systems"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./tsconfig/action.json": "./public/tsconfig/action.json",
		"./loaders/webpack-ignore-dynamic-imports.cjs": "./public/loaders/webpack-ignore-dynamic-imports.cjs"
	},
	"bin": {
		"github-action-builder": "./src/cli/index.ts"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:effect",
		"@effected/yaml": "^0.6.0",
		"@rsbuild/core": "catalog:silk",
		"effect": "catalog:effect",
		"jiti": "^2.7.0",
		"picocolors": "^1.1.1"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:effect",
		"@savvy-web/bundler": "workspace:*",
		"@types/node": "catalog:silk",
		"tsx": "catalog:silk",
		"typescript": "catalog:silk",
		"vitest": "catalog:silk"
	},
	"peerDependencies": {
		"@types/node": "catalog:silkPeers",
		"typescript": "catalog:silkPeers"
	},
	"peerDependenciesMeta": {
		"@types/node": {
			"optional": false
		},
		"typescript": {
			"optional": false
		}
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true,
			"github": true
		}
	}
}
