{
	"extends": ["//"],
	"tasks": {
		"build:dev": {
			"inputs": ["$TURBO_EXTENDS$", "savvy.build.ts"],
			"outputs": ["dist/dev/**"]
		},
		"build:prod": {
			"inputs": ["$TURBO_EXTENDS$", "savvy.build.ts"],
			"outputs": ["dist/prod/**"]
		},
		"types:check": {
			"dependsOn": ["^build:dev", "build:dev"]
		}
	}
}
