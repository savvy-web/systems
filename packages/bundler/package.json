{
	"name": "@savvy-web/bundler",
	"version": "2.0.9",
	"private": true,
	"description": "Zero-config tsdown-based bundler for Silk Suite TypeScript packages",
	"homepage": "https://github.com/savvy-web/systems/tree/main/packages/bundler",
	"bugs": {
		"url": "https://github.com/savvy-web/systems/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/savvy-web/systems.git",
		"directory": "packages/bundler"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@savvyweb.systems",
		"url": "https://savvyweb.systems"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./tsconfig/ecma.json": "./public/tsconfig/ecma.json"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"prepare": "turbo run build:dev",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@savvy-web/tsdown-plugins": "workspace:*",
		"@tsdown/exe": "catalog:silk",
		"effect": "catalog:effect",
		"rolldown": "catalog:silk",
		"tsdown": "catalog:silk"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:effect",
		"@tsdown/css": "catalog:silk",
		"@types/node": "catalog:silk",
		"@types/react": "catalog:silk",
		"@types/react-dom": "catalog:silk",
		"react": "catalog:silk",
		"react-dom": "catalog:silk",
		"typescript": "catalog:silk",
		"vitest": "catalog:silk"
	},
	"peerDependencies": {
		"@types/node": "catalog:silkPeers",
		"@types/react": "catalog:silkPeers",
		"@types/react-dom": "catalog:silkPeers",
		"react": "catalog:silkPeers",
		"react-dom": "catalog:silkPeers",
		"typescript": "catalog:silkPeers"
	},
	"peerDependenciesMeta": {
		"@types/react": {
			"optional": true
		},
		"@types/react-dom": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true,
			"github": true
		}
	}
}
