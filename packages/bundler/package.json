{
	"name": "@savvy-web/bundler",
	"version": "0.0.0",
	"private": true,
	"description": "Zero-config tsdown-based bundler for Silk Suite TypeScript packages",
	"homepage": "https://github.com/savvy-web/systems/tree/main/packages/bundler",
	"bugs": {
		"url": "https://github.com/savvy-web/systems/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/savvy-web/systems.git",
		"directory": "packages/bundler"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@savvyweb.systems",
		"url": "https://savvyweb.systems"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"build:dev": "rslib build --config-loader native --env-mode dev",
		"build:prod": "rslib build --config-loader native --env-mode npm",
		"types:check": "tsgo --noEmit"
	},
	"dependencies": {
		"@savvy-web/tsdown-plugins": "workspace:*",
		"@tsdown/exe": "^0.22.1",
		"tsdown": "^0.22.2"
	},
	"devDependencies": {
		"@effect/platform": "catalog:silk",
		"@effect/platform-node": "catalog:silk",
		"@rslib/core": "0.22.0",
		"@savvy-web/rslib-builder": "^0.21.3",
		"@types/node": "catalog:silk",
		"@typescript/native-preview": "catalog:silk",
		"effect": "catalog:silk",
		"typescript": "catalog:silk",
		"vitest": "^4.1.8"
	},
	"peerDependencies": {
		"effect": "catalog:silkPeers"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev",
		"linkDirectory": true,
		"targets": [
			{
				"protocol": "npm",
				"registry": "https://npm.pkg.github.com/",
				"directory": "dist/npm",
				"access": "public",
				"provenance": true
			},
			{
				"protocol": "npm",
				"registry": "https://registry.npmjs.org/",
				"directory": "dist/npm",
				"access": "public",
				"provenance": true
			}
		]
	}
}
