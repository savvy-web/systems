{
	"name": "@savvy-web/silk",
	"version": "3.11.5",
	"private": true,
	"description": "The single Silk Suite dev-tooling package — changeset, commitlint, lint, and biome conventions",
	"homepage": "https://github.com/savvy-web/systems/tree/main/packages/silk",
	"bugs": {
		"url": "https://github.com/savvy-web/systems/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/savvy-web/systems.git",
		"directory": "packages/silk"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@savvyweb.systems",
		"url": "https://savvyweb.systems"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		"./changesets": "./src/changesets/index.ts",
		"./changesets/changelog": "./src/changesets/changelog.ts",
		"./changesets/markdownlint": "./src/changesets/markdownlint.ts",
		"./changesets/remark": "./src/changesets/remark.ts",
		"./commitlint": "./src/commitlint/index.ts",
		"./commitlint/static": "./src/commitlint/static.ts",
		"./commitlint/prompt": "./src/commitlint/prompt.ts",
		"./commitlint/formatter": "./src/commitlint/formatter.ts",
		"./lint": "./src/lint/index.ts",
		"./biome": "./public/biome/silk.json",
		"./tsconfig/node/root.json": "./public/tsconfig/node/root.json",
		"./tsconfig/rspress/website.json": "./public/tsconfig/rspress/website.json"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"prepare": "turbo run build:dev",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@effected/commands": "catalog:effected",
		"@effected/git": "catalog:effected",
		"@effected/templates": "catalog:effected",
		"@effected/workspaces": "catalog:effected",
		"@savvy-web/changelog": "workspace:*",
		"@savvy-web/cli": "workspace:*",
		"@savvy-web/mcp": "workspace:*",
		"effect": "catalog:effect",
		"semver": "^7.8.5"
	},
	"devDependencies": {
		"@savvy-web/bundler": "workspace:*",
		"@savvy-web/silk-effects": "workspace:*",
		"@types/node": "catalog:build",
		"tsx": "catalog:build",
		"typescript": "catalog:build",
		"vitest": "catalog:test"
	},
	"peerDependencies": {
		"@biomejs/biome": "catalog:lint",
		"@changesets/cli": "catalog:lint",
		"@commitlint/cli": "catalog:lint",
		"@commitlint/config-conventional": "catalog:lint",
		"@types/bun": "catalog:build",
		"@types/node": "catalog:build",
		"@vitest/coverage-istanbul": "catalog:test",
		"@vitest/coverage-v8": "catalog:test",
		"husky": "catalog:lint",
		"lint-staged": "catalog:lint",
		"markdownlint-cli2": "catalog:lint",
		"markdownlint-cli2-formatter-codequality": "catalog:lint",
		"tsx": "catalog:build",
		"turbo": "catalog:lint",
		"typescript": "catalog:build",
		"vitest": "catalog:test"
	},
	"peerDependenciesMeta": {
		"@biomejs/biome": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true,
			"github": true
		}
	}
}
