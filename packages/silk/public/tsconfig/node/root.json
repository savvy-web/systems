{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"composite": true,
		"declaration": true,
		"module": "nodenext",
		"outDir": "dist",
		"resolveJsonModule": true,
		"strict": true,
		"strictNullChecks": true,
		"target": "es2025",
		"types": ["node"]
	},
	"exclude": ["${configDir}/node_modules", "${configDir}/dist/**/*"],
	"include": [
		"${configDir}/types/*.ts",
		"${configDir}/package.json",
		"${configDir}/*.ts",
		"${configDir}/*.cts",
		"${configDir}/*.mts",
		"${configDir}/src/**/*.ts",
		"${configDir}/src/**/*.tsx",
		"${configDir}/src/**/*.cts",
		"${configDir}/src/**/*.mts",
		"${configDir}/lib/**/*.ts",
		"${configDir}/lib/**/*.tsx",
		"${configDir}/lib/**/*.cts",
		"${configDir}/lib/**/*.mts",
		"${configDir}/__test__/**/*.ts",
		"${configDir}/__test__/**/*.tsx",
		"${configDir}/__test__/**/*.cts",
		"${configDir}/__test__/**/*.mts",
		"${configDir}/public/**/*.json"
	]
}
