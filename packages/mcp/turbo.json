{
	"extends": ["//"],
	"tasks": {
		"build:catalog": {
			"cache": true,
			"dependsOn": ["generate:api-docs"],
			"inputs": ["$TURBO_DEFAULT$", "public/content/**", "!public/content/manifest.json"],
			"outputs": ["public/content/manifest.json"]
		},
		"build:prod": {
			"dependsOn": ["types:check", "build:dev", "build:catalog"]
		},
		"generate:api-docs": {
			"cache": true,
			"dependsOn": [
				"@savvy-web/bundler#build:prod",
				"@savvy-web/rspress-builder#build:prod",
				"@savvy-web/tsdown-plugins#build:prod",
				"@savvy-web/silk-effects#build:prod",
				"@savvy-web/templates#build:prod",
				"@savvy-web/github-action-effects#build:prod",
				"@savvy-web/github-action-builder#build:prod"
			],
			"inputs": ["$TURBO_DEFAULT$", "lib/models/*/**"],
			"outputs": ["public/content/packages/*/api/**", "public/content/packages/*/api.md"]
		},
		"inspect": {
			"cache": false,
			"dependsOn": ["build:dev"],
			"outputLogs": "full"
		}
	}
}
