{
	"extends": ["//"],
	"tasks": {
		"build:catalog": {
			"cache": true,
			"dependsOn": ["generate:api-docs"],
			"inputs": ["$TURBO_DEFAULT$", "public/content/**", "!public/content/manifest.json"],
			"outputs": ["public/content/manifest.json"]
		},
		"build:dev": {
			"dependsOn": ["$TURBO_EXTENDS$", "build:catalog"],
			"inputs": ["$TURBO_EXTENDS$", "savvy.build.ts", "public/content/**"],
			"outputs": ["dist/dev/**"]
		},
		"build:prod": {
			"dependsOn": ["$TURBO_EXTENDS$", "build:catalog"],
			"inputs": ["$TURBO_EXTENDS$", "savvy.build.ts", "public/content/**"],
			"outputs": ["dist/prod/**"]
		},
		"generate:api-docs": {
			"cache": true,
			"dependsOn": [
				"@savvy-web/silk-effects#build:meta",
				"@savvy-web/templates#build:meta",
				"@savvy-web/github-action-effects#build:meta",
				"@savvy-web/github-action-builder#build:meta"
			],
			"inputs": ["$TURBO_DEFAULT$", "lib/models/*/**"],
			"outputs": ["public/content/packages/*/api/**"]
		},
		"inspect": {
			"cache": false,
			"dependsOn": ["build:dev"],
			"outputLogs": "full"
		}
	}
}
