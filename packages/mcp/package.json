{
	"name": "@savvy-web/mcp",
	"version": "0.2.0",
	"private": true,
	"description": "The savvy MCP server — Silk Suite tooling and library knowledge for coding agents",
	"homepage": "https://github.com/savvy-web/systems/tree/main/packages/mcp",
	"bugs": {
		"url": "https://github.com/savvy-web/systems/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/savvy-web/systems.git",
		"directory": "packages/mcp"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@savvyweb.systems",
		"url": "https://savvyweb.systems"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"bin": {
		"savvy-mcp": "./src/bin.ts"
	},
	"scripts": {
		"build:catalog": "tsx lib/scripts/build-catalog.ts",
		"build:dev": "rslib build --config-loader native --env-mode dev",
		"build:prod": "rslib build --config-loader native --env-mode npm",
		"generate:api-docs": "tsx lib/scripts/generate-api-docs.ts",
		"inspect": "exec mcp-inspector node ./dist/dev/bin/savvy-mcp.js",
		"prepare": "turbo run build:dev",
		"types:check": "tsgo --noEmit"
	},
	"dependencies": {
		"@effect/platform": "catalog:silk",
		"@effect/platform-node": "catalog:silk",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@savvy-web/silk-effects": "workspace:*",
		"effect": "catalog:silk",
		"fuse.js": "^7.4.0",
		"workspaces-effect": "^1.1.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@modelcontextprotocol/inspector": "^0.21.2",
		"@rslib/core": "0.22.0",
		"@savvy-web/rslib-builder": "^0.21.0",
		"@types/node": "catalog:silk",
		"@typescript/native-preview": "catalog:silk",
		"api-extractor-llms": "^0.1.0",
		"gray-matter": "^4.0.3",
		"tsx": "^4.22.4",
		"typescript": "catalog:silk",
		"vitest": "^4.1.8"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev",
		"linkDirectory": true,
		"targets": [
			{
				"protocol": "npm",
				"registry": "https://npm.pkg.github.com/",
				"directory": "dist/npm",
				"access": "public",
				"provenance": true
			},
			{
				"protocol": "npm",
				"registry": "https://registry.npmjs.org/",
				"directory": "dist/npm",
				"access": "public",
				"provenance": true
			}
		]
	}
}
