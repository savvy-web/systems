{
	"name": "@savvy-web/pnpm-plugin-silk",
	"version": "0.53.0",
	"private": true,
	"description": "pnpm config dependency for centralized catalog management across the Silk ecosystem.",
	"keywords": ["pnpm", "pnpm-plugin", "config-dependency", "catalog", "monorepo", "silk"],
	"homepage": "https://github.com/savvy-web/systems/packages/pnpm-plugin-silk#readme",
	"bugs": {
		"url": "https://github.com/savvy-web/systems/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/savvy-web/systems.git",
		"directory": "packages/pnpm-plugin-silk"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@savvyweb.systems",
		"url": "https://savvyweb.systems"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "effected package build",
		"pnpm:export": "cd lib/build && rolldown-pnpm-config export",
		"pnpm:preview": "cd lib/build && rolldown-pnpm-config preview",
		"pnpm:up": "rolldown-pnpm-config upgrade lib/build/pnpm-config.plugin.ts",
		"types:check": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "catalog:effected:build",
		"rolldown-pnpm-config": "^2.4.8",
		"typescript": "catalog:effected:build",
		"vitest": "catalog:test"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"targets": {
			"npm": true
		}
	}
}
