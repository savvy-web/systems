		"@types/mdast": "^4.0.4",
		"@types/node": "catalog:silk",
		"@types/shell-quote": "^1.7.5",
		"effect": "catalog:silk",
		"fast-check": "^4.8.0",
		"markdownlint": "^0.40.0"
	},
	"peerDependencies": {
		"@effect/platform": "catalog:silkPeers",
		"effect": "catalog:silkPeers"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev",
		"linkDirectory": true,
		"targets": [
			{
				"protocol": "npm",
				"registry": "https://npm.pkg.github.com/",
				"directory": "dist/npm",
				"access": "public",
				"provenance": true
			},
			{
				"protocol": "npm",
				"registry": "https://registry.npmjs.org/",
				"directory": "dist/npm",
				"access": "public",
				"provenance": true
			}
		]
	}
