		"prettier": "^3.8.3",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-stringify": "^11.0.0",
		"semver-effect": "^0.2.1",
		"shell-quote": "^1.8.4",
		"sort-package-json": "^3.6.1",
		"tinyglobby": "^0.2.16",
		"unified": "^11.0.5",
		"unified-lint-rule": "^3.0.1",
		"unist-util-visit": "^5.1.0",
		"workspaces-effect": "^1.1.0",
		"yaml": "^2.9.0",
		"yaml-effect": "^0.6.0",
		"yaml-lint": "^1.7.0"
	},
	"devDependencies": {
		"@changesets/types": "^6.1.0",
		"@commitlint/types": "^21.0.1",
		"@effect/platform-node": "catalog:silk",
