		"std-env": "^4.1.0",
		"workspaces-effect": "^1.2.0"
	},
	"devDependencies": {
		"@effect/platform": "catalog:silk",
		"@types/deep-equal": "^1.0.4",
		"@types/node": "catalog:silk",
		"@typescript/native-preview": "catalog:silk",
		"effect": "catalog:silk",
		"rolldown": "^1.1.0",
		"tsdown": "^0.22.2",
		"tsx": "^4.22.4",
		"typescript": "catalog:silk",
		"vitest": "^4.1.8"
	},
	"peerDependencies": {
		"effect": "catalog:silkPeers"
