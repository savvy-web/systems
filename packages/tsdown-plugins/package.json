{
	"name": "@savvy-web/tsdown-plugins",
	"version": "2.11.3",
	"private": true,
	"description": "Interface-only tsdown/rolldown plugin pack powering @savvy-web/bundler",
	"homepage": "https://github.com/savvy-web/systems/tree/main/packages/tsdown-plugins",
	"bugs": {
		"url": "https://github.com/savvy-web/systems/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/savvy-web/systems.git",
		"directory": "packages/tsdown-plugins"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@savvyweb.systems",
		"url": "https://savvyweb.systems"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"build:dev": "tsx savvy.build.ts --target dev",
		"build:prod": "tsx savvy.build.ts --target prod",
		"prepare": "turbo run build:dev",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@changesets/get-release-plan": "^5.0.2",
		"@effect/platform-node": "catalog:effect",
		"@effected/env": "catalog:effected",
		"@effected/glob": "catalog:effected",
		"@effected/images": "catalog:effected",
		"@effected/jsonc": "catalog:effected",
		"@effected/npm": "catalog:effected",
		"@effected/package-json": "catalog:effected",
		"@effected/semver": "catalog:effected",
		"@effected/tsconfig-json": "catalog:effected",
		"@effected/walker": "catalog:effected",
		"@effected/workspaces": "catalog:effected",
		"@jridgewell/sourcemap-codec": "^1.6.0",
		"@microsoft/api-extractor": "catalog:build",
		"@microsoft/tsdoc": "catalog:build",
		"@microsoft/tsdoc-config": "catalog:build",
		"@tsdoctor/manifest": "^0.2.11",
		"effect": "catalog:effect",
		"picocolors": "^1.1.1",
		"tsdown": "catalog:build",
		"typescript": "7.1.0-beta"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:effect",
		"@types/node": "catalog:build",
		"rolldown": "catalog:build",
		"tsx": "catalog:build",
		"vitest": "catalog:test"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true,
			"github": true
		}
	}
}
