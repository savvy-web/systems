{
	"name": "@savvy-web/tsdown-plugins",
	"version": "2.2.0",
	"private": true,
	"description": "Interface-only tsdown/rolldown plugin pack powering @savvy-web/bundler",
	"homepage": "https://github.com/savvy-web/systems/tree/main/packages/tsdown-plugins",
	"bugs": {
		"url": "https://github.com/savvy-web/systems/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/savvy-web/systems.git",
		"directory": "packages/tsdown-plugins"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@savvyweb.systems",
		"url": "https://savvyweb.systems"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"build:dev": "tsx savvy.build.ts --target dev",
		"build:prod": "tsx savvy.build.ts --target prod",
		"prepare": "turbo run build:dev",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@changesets/get-release-plan": "^5.0.0-next.7",
		"@effect/platform-node": "catalog:effect",
		"@effected/npm": "^0.4.0",
		"@effected/package-json": "^0.5.2",
		"@effected/tsconfig-json": "^0.3.2",
		"@effected/workspaces": "^0.8.0",
		"@microsoft/api-extractor": "^7.58.12",
		"@microsoft/tsdoc": "^0.16.0",
		"@microsoft/tsdoc-config": "^0.18.1",
		"effect": "catalog:effect",
		"picocolors": "^1.1.1",
		"std-env": "^4.2.0",
		"tsdown": "catalog:silk",
		"typescript": "^6.0.3"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:effect",
		"@types/node": "catalog:silk",
		"rolldown": "catalog:silk",
		"tsx": "catalog:silk",
		"vitest": "catalog:silk"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true,
			"github": true
		}
	}
