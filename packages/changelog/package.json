		"@effected/npm": "catalog:effected:exact",
		"@effected/semver": "catalog:effected:exact",
		"@effected/templates": "catalog:effected:exact",
		"@effected/toml": "catalog:effected:exact",
		"@effected/workspaces": "catalog:effected:exact",
		"@effected/yaml": "catalog:effected:exact",
		"@savvy-web/silk-effects": "workspace:*",
