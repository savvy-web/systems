{
	"name": "@savvy-web/cli",
	"version": "2.2.1",
	"private": true,
	"description": "The savvy CLI — unified commit, changeset, and lint commands for the Silk Suite",
	"homepage": "https://github.com/savvy-web/systems/tree/main/packages/cli",
	"bugs": {
		"url": "https://github.com/savvy-web/systems/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/savvy-web/systems.git",
		"directory": "packages/cli"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@savvyweb.systems",
		"url": "https://savvyweb.systems"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"bin": {
		"savvy": "./src/bin/cli.ts"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"prepare": "turbo run build:dev",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:effect",
		"@effected/commands": "^0.2.1",
		"@effected/git": "^0.5.2",
		"@effected/jsonc": "^0.5.2",
		"@effected/templates": "^0.1.1",
		"@effected/workspaces": "^0.9.5",
		"@effected/yaml": "^0.6.1",
		"@savvy-web/silk-effects": "workspace:*",
		"effect": "catalog:effect"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:effect",
		"@savvy-web/bundler": "workspace:*",
		"@types/node": "catalog:build",
		"tsx": "catalog:build",
		"typescript": "catalog:build",
		"vitest": "catalog:test"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true,
			"github": true
		}
	}
}
