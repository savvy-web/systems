		"@effected/env": "catalog:effected",
		"@effected/git": "catalog:effected",
		"@effected/github": "catalog:effected",
		"@effected/glob": "catalog:effected",
		"@effected/jsonc": "catalog:effected",
		"@effected/kit": "catalog:effected",
		"@effected/markdown": "catalog:effected",
		"@effected/markdown-lint": "catalog:effected",
		"@effected/templates": "catalog:effected",
		"@effected/toml": "catalog:effected",
		"@effected/walker": "catalog:effected",
		"@effected/workspaces": "catalog:effected",
		"@effected/yaml": "catalog:effected",
		"@savvy-web/silk-effects": "workspace:^",
		"effect": "catalog:effected",
		"ink": "catalog:silk",
