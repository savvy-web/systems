{
	"name": "@savvy-web/rspress-builder",
	"version": "1.0.21",
	"private": true,
	"description": "RSPress plugin builder for the Silk Suite, built on @savvy-web/bundler",
	"homepage": "https://github.com/savvy-web/systems/tree/main/packages/rspress-builder",
	"bugs": {
		"url": "https://github.com/savvy-web/systems/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/savvy-web/systems.git",
		"directory": "packages/rspress-builder"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@savvyweb.systems",
		"url": "https://savvyweb.systems"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./rspress-env.d.ts": "./public/rspress-env.d.ts",
		"./tsconfig/ecma.json": "./public/ecma.json",
		"./tsconfig/plugin.json": "./public/tsconfig/plugin.json"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@savvy-web/bundler": "workspace:*",
		"@savvy-web/tsdown-plugins": "workspace:*",
		"@tsdown/css": "catalog:silk"
	},
	"devDependencies": {
		"@types/node": "catalog:silk",
		"@types/react": "catalog:silk",
		"react": "catalog:silk",
		"typescript": "catalog:silk",
		"vitest": "catalog:silk"
	},
	"peerDependencies": {
		"@rspress/core": "catalog:silkPeers",
		"@types/node": "catalog:silkPeers",
		"@types/react": "catalog:silkPeers",
		"@types/react-dom": "catalog:silkPeers",
		"react": "catalog:silkPeers",
		"react-dom": "catalog:silkPeers",
		"typescript": "catalog:silkPeers"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true,
			"github": true
		}
	}
}
