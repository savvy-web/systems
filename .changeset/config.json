{
	"$schema": "https://unpkg.com/@changesets/config@3.1.1/schema.json",
	"changelog": [
		"@savvy-web/silk/changesets/changelog",
		{
			"repo": "savvy-web/systems",
			"packages": {
				"@savvy-web/silk": {
					"versionFiles": [
						{
							"glob": "plugins/*/.claude-plugin/plugin.json",
							"paths": ["$.version"]
						}
					]
				}
			}
		}
	],
	"commit": false,
	"access": "restricted",
	"baseBranch": "main",
	"updateInternalDependencies": "patch",
	"fixed": [["@savvy-web/silk", "@savvy-web/cli"]],
	"ignore": [],
	"privatePackages": {
		"tag": true,
		"version": true
	}
}
