{
	"$schema": "https://unpkg.com/@changesets/config@4.0.0/schema.json",
	"access": "restricted",
	"baseBranch": "main",
	"changelog": [
		"@savvy-web/changelog",
		{
			"packages": {
				"@savvy-web/ai-plugins": {
					"additionalScopes": [".github/workflows/hook-tests.yml", ".github/plugin/**"],
					"versionFiles": [
						{
							"glob": "plugin/builds/claude/.claude-plugin/plugin.json",
							"paths": ["$.version"]
						},
						{
							"glob": "plugin/builds/copilot/plugin.json",
							"paths": ["$.version"]
						}
					]
				}
			},
			"repo": "savvy-web/systems"
		}
	],
	"commit": false,
	"format": false,
	"ignore": [],
	"privatePackages": {
		"tag": true,
		"version": true
	},
	"updateInternalDependencies": "patch"
}
