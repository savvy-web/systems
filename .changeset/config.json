{
	"$schema": "https://unpkg.com/@changesets/config@4.0.0/schema.json",
	"access": "restricted",
	"baseBranch": "main",
	"changelog": [
		"@savvy-web/changelog",
		{
			"packages": {
				"@savvy-web/silk": {
					"additionalScopes": ["plugins/silk/**", ".github/workflows/hook-tests.yml"],
					"versionFiles": [
						{
							"glob": "plugins/*/.claude-plugin/plugin.json",
							"paths": ["$.version"]
						}
					]
				}
			},
			"repo": "savvy-web/systems"
		}
	],
	"commit": false,
	"format": false,
	"ignore": [],
	"privatePackages": {
		"tag": true,
		"version": true
	},
	"updateInternalDependencies": "patch"
}
