{
	"$schema": "https://www.schemastore.org/claude-code-plugin-manifest.json",
	"author": {
		"email": "spencer@savvyweb.systems",
		"name": "C. Spencer Beggs",
		"url": "https://savvyweb.systems"
	},
	"description": "Companion plugin for @savvy-web/silk — changeset, commit, lint, and Turborepo conventions, skills, and agents for the Silk Suite",
	"homepage": "https://github.com/savvy-web/systems",
	"keywords": ["silk-suite", "changesets", "commitlint", "lint-staged", "biome", "code-quality", "turborepo"],
	"license": "MIT",
	"lspServers": {
		"biome": {
			"args": ["${CLAUDE_PLUGIN_ROOT}/bin/biome-lsp.sh"],
			"command": "sh",
			"extensionToLanguage": {
				".cjs": "javascript",
				".css": "css",
				".cts": "typescript",
				".gql": "graphql",
				".graphql": "graphql",
				".js": "javascript",
				".json": "json",
				".jsonc": "jsonc",
				".jsx": "javascriptreact",
				".mjs": "javascript",
				".mts": "typescript",
				".ts": "typescript",
				".tsx": "typescriptreact"
			}
		}
	},
	"mcpServers": {
		"savvy-mcp": {
			"args": ["${CLAUDE_PLUGIN_ROOT}/bin/start-mcp.sh"],
			"command": "sh"
		}
	},
	"name": "silk",
	"repository": "https://github.com/savvy-web/systems.git",
	"version": "3.10.6"
}
