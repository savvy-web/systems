**/.DS_Store
**/node_modules
**/*.tsbuildinfo
**/build
# Allow src/build and __test__/build source directories (not output dirs)
!**/src/build/
!**/__test__/build/
**/.rslib
**/.artifacts
**/.turbo
**/.coverage
**/.vitest
**/.cache
**/dist
# silk-effects integration fixtures ship hand-authored dist/prod bindings
# (dist/prod/targets.json + built-private package.json) that MUST be committed —
# they are test inputs, not build output. Re-include them after the broad **/dist.
!packages/silk-effects/__test__/integration/fixtures/**/dist/
!packages/silk-effects/__test__/integration/fixtures/**/dist/**
coverage/
**/*.asc
pnpm-publish-summary.json
pnpm-release.json
.changeset/status.json
# Environment files (keep .example files committed)
.env
.env.local
.env.development
.env.production
.env.test
.env.workflow
.env.workflow-cli
!.env.example
!.env.*.example
.pnpm-release.json


# Claude Code Files
.claude/settings.local.json
.claude/plans
.claude/agents
.claude/cache
.claude/skills
.claude/worktrees
CLAUDE.local.md
**/coverage-debug
.claude/plugins-debug.log
docs/superpowers
.act.secrets.env
.mcp.json
.worktrees
docs/superpowers

# Local development files
# The raw API Extractor models are gitignored, but the rendered api markdown
# they produce (under public/content/packages/*/api/) IS committed: a clean
# release machine never runs generate:api-docs, so an uncommitted corpus would
# ship nothing and every silk://packages/<pkg>/api read would 404 (#178/#179).
packages/mcp/lib/models/*/

# bundler meta-prod integration fixture build artifacts
packages/bundler/__test__/integration/fixtures/meta-prod/dist/
packages/bundler/__test__/integration/fixtures/meta-prod/models/
packages/bundler/__test__/integration/fixtures/meta-prod/tsdoc.json

# bundler multi-meta integration fixture build artifacts
packages/bundler/__test__/integration/fixtures/multi-meta/dist/
packages/bundler/__test__/integration/fixtures/multi-meta/models/
packages/bundler/__test__/integration/fixtures/multi-meta/tsdoc.json

# bundler multitarget integration fixture build artifacts
packages/bundler/__test__/integration/fixtures/multitarget/dist/

# bundler jsx integration fixture build artifacts
packages/bundler/__test__/integration/fixtures/jsx/dist/

# bundler exe integration fixture build artifacts
packages/bundler/__test__/integration/fixtures/exe/dist/
packages/bundler/__test__/integration/fixtures/exe/bin/

# bundler dual-format integration fixture build artifacts
packages/bundler/__test__/integration/fixtures/dual-format/dist/

# Claude Code autonomous-loop wakeup lock (transient harness artifact)
.claude/scheduled_tasks.lock


# Don't store models for now
website/lib/models/*