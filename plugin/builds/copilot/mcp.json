{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
	"mcpServers": {
		"savvy-mcp": {
			"type": "stdio",
			"command": "sh",
			"args": [
				"${PLUGIN_ROOT}/bin/start-mcp.sh"
			],
			"env": {
				"PLUGINFINITY_HOST": "copilot",
				"PLUGINFINITY_PLUGIN": "silk",
				"PLUGINFINITY_LIB": "${PLUGIN_ROOT}/lib/pluginfinity"
			}
		}
	}
}
