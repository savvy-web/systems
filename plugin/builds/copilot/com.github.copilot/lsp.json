{
	"lspServers": {
		"biome": {
			"command": "sh",
			"args": [
				"${PLUGIN_ROOT}/bin/biome-lsp.sh"
			],
			"fileExtensions": {
				".cjs": "javascript",
				".css": "css",
				".cts": "typescript",
				".gql": "graphql",
				".graphql": "graphql",
				".js": "javascript",
				".json": "json",
				".jsonc": "jsonc",
				".jsx": "javascriptreact",
				".mjs": "javascript",
				".mts": "typescript",
				".ts": "typescript",
				".tsx": "typescriptreact"
			},
			"env": {
				"PLUGINFINITY_HOST": "copilot",
				"PLUGINFINITY_PLUGIN": "silk",
				"PLUGINFINITY_LIB": "${PLUGIN_ROOT}/lib/pluginfinity"
			}
		}
	}
}
