	"paths": {
		"context": "CLAUDE.md",
		"designDocs": ".claude/design",
		"localContext": "CLAUDE.local.md",
		"plans": ".claude/plans",
		"skills": ".claude/skills"
	},
	"project": {
		"maintainer": "C. Spencer Beggs",
		"name": "savvy-web/systems",
		"repository": "https://github.com/savvy-web/systems",
		"type": "monorepo"
	},
	"quality": {
		"context": {
			"childMaxLines": 300,
			"requireDesignDocPointers": true,
			"rootMaxLines": 500
		},
		"designDocs": {
			"maxLineLength": 120,
			"minSections": ["Overview", "Current State", "Rationale"],
			"requireFrontmatter": true,
			"requireTOC": true
		},
		"plans": {
			"archiveAfterDays": 30,
			"maxLineLength": 120,
			"progressRange": [0, 100],
			"requiredFields": ["name", "title", "created", "status", "progress"],
			"requireFrontmatter": true,
			"stalenessThresholdDays": 30,
			"validStatuses": ["ready", "in-progress", "blocked", "completed", "abandoned"]
		},
		"userDocs": {
			"level1": {
				"maxLineLength": 80,
				"requireSections": ["Features", "Installation", "Usage"],
				"targetWordCount": [200, 500]
			},
			"level2": {
				"maxLineLength": 120,
				"requireNavigation": true
			},
			"level3": {
				"framework": "rspress",
				"requireCodeExamples": true,
				"requireMetadata": true
			}
		}
	},
	"skills": {
		"baseNamespace": "design-docs:",
		"enabled": [
			"design-init",
			"design-validate",
			"design-update",
			"design-sync",
			"design-review",
			"design-audit",
			"design-search",
			"design-index",
			"design-link",
			"design-report",
			"design-prune",
			"plan-create",
			"plan-list",
			"plan-explore",
			"plan-validate",
			"plan-complete",
			"context-review",
			"context-update",
			"context-validate",
			"docs-generate-readme",
			"docs-generate-repo",
			"docs-review"
		]
	},
	"version": "1.0.0"
}
